<Window x:Class="ScreenshotApp.Capture.ScrollCaptureWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ScreenshotApp.Resources"
        Title="{res:Str Scroll_Title}" Width="310" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="14">
        <TextBlock Text="{res:Str Scroll_Help}" TextWrapping="Wrap" />
        <TextBlock x:Name="HeightText" Margin="0,10,0,6" FontWeight="SemiBold" />
        <Border Background="#202020" Height="150" Padding="4">
            <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="{res:Str Scroll_Preview}" />
        </Border>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8" MinHeight="36" />
        <Button x:Name="AutomaticButton" Padding="8,5" Content="{res:Str Scroll_Automatic}" Click="Automatic_Click" />
        <UniformGrid Columns="2" Margin="0,8,0,0">
            <Button x:Name="FinishButton" Margin="0,0,4,0" Padding="8,5" Content="{res:Str Scroll_Finish}" Click="Finish_Click" />
            <Button x:Name="CancelCaptureButton" Margin="4,0,0,0" Padding="8,5" Content="{res:Str Scroll_Cancel}" Click="Cancel_Click" />
        </UniformGrid>
    </StackPanel>
</Window>
