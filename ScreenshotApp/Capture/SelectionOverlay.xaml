<UserControl x:Class="ScreenshotApp.Capture.SelectionOverlay"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ScreenshotApp.Resources"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             UseLayoutRounding="True">
    <Grid>
        <!-- 快照鋪滿用戶區：用戶區的 DIP 尺寸乘上 DPI 縮放正好是顯示器的實體像素，最近鄰取樣確保像素一對一。 -->
        <Image x:Name="SnapshotImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <!-- 遮罩與外框的邊界都落在實體像素格線上；不做平滑處理，邊緣像素才不會被半暗化或混色。 -->
        <Path x:Name="Mask" Fill="#80000000" RenderOptions.EdgeMode="Aliased" />
        <Path x:Name="SelectionFrame" Fill="#FF0078D7" RenderOptions.EdgeMode="Aliased" Visibility="Collapsed" />
        <Canvas>
            <Border x:Name="SizeLabel" Background="#E6202020" CornerRadius="3" Padding="6,2" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" />
            </Border>
        </Canvas>
        <TextBlock Text="{res:Str Selection_Help}" Foreground="White" Background="#E6202020"
                   Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" />
        <Canvas IsHitTestVisible="False">
            <Canvas x:Name="MagnifierPanel" Background="#FF202020" Visibility="Collapsed">
                <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderOptions.EdgeMode="Aliased" />
                <Path x:Name="MagnifierOuterFrame" Fill="Black" RenderOptions.EdgeMode="Aliased" />
                <Path x:Name="MagnifierInnerFrame" Fill="White" RenderOptions.EdgeMode="Aliased" />
                <TextBlock x:Name="MagnifierText" Foreground="White" Padding="4,2" />
            </Canvas>
        </Canvas>
    </Grid>
</UserControl>
