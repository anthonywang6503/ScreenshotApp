<Window x:Class="ScreenshotApp.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ScreenshotApp.Resources"
        Title="{res:Str Settings_Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16" Width="460">
        <GroupBox Header="{res:Str Settings_HotkeyGroup}">
            <StackPanel>
                <DockPanel>
                    <Label DockPanel.Dock="Left" Padding="0,0,8,0" VerticalAlignment="Center"
                           Content="{res:Str Settings_HotkeyLabel}"
                           Target="{Binding ElementName=HotkeyBox}" />
                    <TextBox x:Name="HotkeyBox" MinHeight="26" Padding="4,0" VerticalContentAlignment="Center"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                             InputMethod.IsInputMethodEnabled="False"
                             ToolTip="{res:Str Settings_HotkeyToolTip}"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                             PreviewKeyUp="HotkeyBox_PreviewKeyUp"
                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                </DockPanel>
                <TextBlock Style="{StaticResource HintText}" Text="{res:Str Settings_HotkeyHint}" />
                <TextBlock x:Name="HotkeyStatusText" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{res:Str Settings_GeneralGroup}">
            <StackPanel>
                <CheckBox x:Name="StartWithWindowsBox"
                          Content="{res:Str Settings_StartWithWindows}"
                          ToolTip="{res:Str Settings_StartWithWindowsToolTip}" />
                <Label Padding="0" Margin="0,10,0,4"
                       Content="{res:Str Settings_LastSaveDirectoryLabel}"
                       Target="{Binding ElementName=LastSaveDirectoryBox}" />
                <TextBox x:Name="LastSaveDirectoryBox" IsReadOnly="True" Padding="4,2" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{res:Str Settings_StyleGroup}">
            <StackPanel>
                <Label Padding="0" Margin="0,0,0,4"
                       Content="{res:Str Settings_ColorLabel}"
                       Target="{Binding ElementName=ColorList}" />
                <ListBox x:Name="ColorList" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="ToolTip" Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Border Width="16" Height="16" BorderThickness="1"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Color}" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="CustomColorButton" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,2"
                        Content="{res:Str Settings_CustomColor}"
                        ToolTip="{res:Str Settings_CustomColorToolTip}"
                        Click="CustomColorButton_Click" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Label Padding="0,0,8,0" VerticalAlignment="Center"
                           Content="{res:Str Settings_StrokeWidthLabel}"
                           Target="{Binding ElementName=StrokeWidthBox}" />
                    <ComboBox x:Name="StrokeWidthBox" MinWidth="80"
                              ItemStringFormat="{res:Str Settings_PixelFormat}" />
                    <Label Padding="24,0,8,0" VerticalAlignment="Center"
                           Content="{res:Str Settings_FontSizeLabel}"
                           Target="{Binding ElementName=FontSizeBox}" />
                    <ComboBox x:Name="FontSizeBox" MinWidth="80"
                              ItemStringFormat="{res:Str Settings_PixelFormat}" />
                </StackPanel>
                <TextBlock Style="{StaticResource HintText}" Text="{res:Str Settings_SizeHint}" />
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Style="{StaticResource DialogButton}" IsDefault="True"
                    Content="{res:Str Settings_Ok}" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="{res:Str Settings_Cancel}" Click="CancelButton_Click" />
            <Button x:Name="ApplyButton" Style="{StaticResource DialogButton}"
                    Content="{res:Str Settings_Apply}" Click="ApplyButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
