<Window x:Class="ScreenshotApp.History.HistoryWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ScreenshotApp.Resources"
        Title="{res:Str History_Title}" Width="660" Height="540" MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <DockPanel x:Name="HistoryContent" Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{res:Str History_Privacy}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap" />
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="OpenHistoryButton" Content="{res:Str History_Open}" ToolTip="{res:Str History_OpenHint}" Click="Open_Click" />
            <Button x:Name="CopyHistoryButton" Content="{res:Str History_Copy}" ToolTip="{res:Str History_CopyHint}" Click="Copy_Click" />
            <Button x:Name="DeleteHistoryButton" Content="{res:Str History_Delete}" ToolTip="{res:Str History_DeleteHint}" Click="Delete_Click" />
            <Button x:Name="ClearHistoryButton" Content="{res:Str History_Clear}" ToolTip="{res:Str History_ClearHint}" Click="Clear_Click" />
            <Button x:Name="RefreshHistoryButton" Content="{res:Str History_Refresh}" ToolTip="{res:Str History_RefreshHint}" Click="Refresh_Click" />
        </WrapPanel>
        <ListBox x:Name="EntriesList" SelectionMode="Single" SelectionChanged="Selection_Changed"
                 MouseDoubleClick="Open_Click" PreviewKeyDown="Entries_KeyDown" AutomationProperties.Name="{res:Str History_Title}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <Image Source="{Binding Thumbnail}" Width="120" Height="80" Stretch="Uniform" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
