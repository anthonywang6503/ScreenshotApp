<Window x:Class="ScreenshotApp.Editor.UnsavedChangesDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ScreenshotApp.Resources"
        Title="{res:Str App_Name}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="{res:Str UnsavedChanges_Message}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
        <!-- 預設按鈕是另存（會再開啟存檔對話框）；取消對應 Esc 與關閉對話框，沒有預設為捨棄的按鈕。 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource DialogButton}" IsDefault="True"
                    ToolTip="{res:Str UnsavedChanges_SaveToolTip}" Click="Save_Click">
                <AccessText Text="{res:Str UnsavedChanges_Save}" />
            </Button>
            <Button x:Name="CopyButton" Style="{StaticResource DialogButton}"
                    ToolTip="{res:Str UnsavedChanges_CopyToolTip}" Click="Copy_Click">
                <AccessText Text="{res:Str UnsavedChanges_Copy}" />
            </Button>
            <Button x:Name="DiscardButton" Style="{StaticResource DialogButton}"
                    ToolTip="{res:Str UnsavedChanges_DiscardToolTip}" Click="Discard_Click">
                <AccessText Text="{res:Str UnsavedChanges_Discard}" />
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" IsCancel="True"
                    ToolTip="{res:Str UnsavedChanges_CancelToolTip}">
                <AccessText Text="{res:Str UnsavedChanges_Cancel}" />
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
